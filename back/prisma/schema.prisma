generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  SOLD
  INACTIVE
}

enum ClientType {
  PF
  PJ
}

enum PaymentMethod {
  CASH
  FINANCING
  CONSORTIUM
  CARD
  PIX
  BOLETO
  OTHER
}

enum UserRole {
  ADMIN
  SELLER
}

model Vehicle {
  id           String        @id @default(cuid())
  plate        String        @unique
  renavam      String?
  chassis      String?
  brand        String
  model        String
  version      String
  yearFab      Int
  yearModel    Int
  color        String
  fuel         String
  gear         String
  km           Int
  salePrice    Decimal       @db.Decimal(12, 2)
  costPrice    Decimal?      @db.Decimal(12, 2)
  status       VehicleStatus @default(AVAILABLE)
  observations String?
  createdAt    DateTime      @default(now())

  sales Sale[]

  @@map("vehicles")
}

model Client {
  id           String     @id @default(cuid())
  type         ClientType
  name         String
  cpfCnpj      String     @unique
  rgIe         String?
  phone        String
  email        String     @unique
  cep          String
  street       String
  number       String
  neighborhood String
  city         String
  state        String
  observations String?
  createdAt    DateTime   @default(now())

  sales Sale[]

  @@map("clients")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(SELLER)
  createdAt DateTime @default(now())

  sales Sale[] @relation("UserSales")

  @@map("users")
}

model Sale {
  id                String        @id @default(cuid())
  clientId          String
  vehicleId         String
  saleDate          DateTime
  listPrice         Decimal       @db.Decimal(12, 2)
  discountValue     Decimal       @default(0) @db.Decimal(12, 2)
  finalValue        Decimal       @db.Decimal(12, 2)
  paymentMethod     PaymentMethod
  downPayment       Decimal?      @db.Decimal(12, 2)
  installmentsCount Int?
  installmentsValue Decimal?      @db.Decimal(12, 2)
  observations      String?
  sellerId          String
  createdAt         DateTime      @default(now())

  client  Client  @relation(fields: [clientId], references: [id], onDelete: Restrict)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  seller  User    @relation("UserSales", fields: [sellerId], references: [id], onDelete: Restrict)

  @@map("sales")
}
